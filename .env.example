MONGODB_URI=
# Restrict in Cloud Console to the Google APIs you enable (e.g. Maps, Places)
GOOGLE_API_KEY=

# Optional: Programmable Search Engine ID — not used by the app; stash your CX if you want it documented for later.
GOOGLE_CSE_CX=

# Set to 0 to skip headless Chromium social fallback (serverless hosts usually cannot run Playwright)
# SOCIAL_BROWSER=0

# Session signing in production (falls back to MONGODB_URI in dev if unset)
AUTH_SECRET=

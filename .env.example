MONGODB_URI=
# Restrict in Cloud Console to the Google APIs you enable (e.g. Maps, Places)
GOOGLE_API_KEY=

# Set to 0 to skip headless Chromium (Ad Library, SERP Playwright fallback, Facebook verify)
# System Chrome is preferred by default; set PLAYWRIGHT_CHROME_CHANNEL=bundled to force Playwright's browser
# SOCIAL_BROWSER=0

# Session signing in production (falls back to MONGODB_URI in dev if unset)
AUTH_SECRET=

# Groq: AI picks/verifies social candidates from search results only (never invents handles)
GROQ_API_KEY=
# Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
